# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables (Production + Preview).
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification code (only the content="..." value).
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile. Leave both empty to hide the captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Canonical site URL used in sitemap, robots, canonical tags, and schema.
NEXT_PUBLIC_SITE_URL=https://www.doggiezenandden.com

# Optional. Overrides the Supabase form endpoint the contact form forwards to.
FORM_ENDPOINT=
